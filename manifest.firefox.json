{
  "manifest_version": 3,
  "name": "Hocus Focus",
  "version": "3.0",
  "description": "Track focus domains and nudge you back when switching to distractions. Hocus Focus!",
  "browser_specific_settings": {
    "gecko": {
      "id": "hocus-focus@arunimaagrawal.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "notifications",
    "scripting",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/firebase-bundle.js",
      "firebase-config.js",
      "firebase-client.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo.jpg",
        "analysis/*",
        "onboarding.html",
        "lib/firebase-bundle.js",
        "firebase-config.js",
        "firebase-client.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
