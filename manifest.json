{
  "manifest_version": 3,
  "name": "Focus Flow Analyzer",
  "version": "1.0",
  "description": "Track study domains and nudge focus when switching to non-study tabs.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "notifications",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "logo.jpg",
      "32": "logo.jpg",
      "48": "logo.jpg",
      "128": "logo.jpg"
    }
  },
  "icons": {
    "16": "logo.jpg",
    "32": "logo.jpg",
    "48": "logo.jpg",
    "128": "logo.jpg"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.jpg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}