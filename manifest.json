{
  "manifest_version": 3,
  "name": "Focus Flow Analyzer",
  "version": "1.0",
  "description": "Track study domains and nudge focus when switching to non-study tabs.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "notifications",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo.jpg",
        "analysis/*",
        "onboarding.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}